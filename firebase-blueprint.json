{
  "entities": {
    "JournalEntry": {
      "path": "users/{userId}/entries/{entryId}",
      "fields": {
        "userId": { "type": "string", "description": "The user UID owner of this journal entry" },
        "title": { "type": "string", "description": "Short title or generated summary title" },
        "content": { "type": "string", "description": "The original reflection text written by the user" },
        "aiResponse": {
          "type": "object",
          "description": "Structured AI reflection payload",
          "properties": {
            "conversationalReply": { "type": "string" },
            "moodTags": { "type": "array", "items": { "type": "string" } },
            "actionableTakeaways": { "type": "array", "items": { "type": "string" } }
          }
        },
        "moodTags": { "type": "array", "items": { "type": "string" }, "description": "Extracted mood tags" },
        "createdAt": { "type": "timestamp", "description": "Creation timestamp in Firestore" },
        "updatedAt": { "type": "timestamp", "description": "Last updated timestamp in Firestore" },
        "wordCount": { "type": "number", "description": "Word count of reflection" },
        "isFavorite": { "type": "boolean", "description": "Whether user marked entry as favorite" }
      }
    },
    "AdminActionLog": {
      "path": "admin_action_logs/{logId}",
      "fields": {
        "id": { "type": "string", "description": "Action log identifier" },
        "adminUid": { "type": "string", "description": "UID of admin who performed action" },
        "adminEmail": { "type": "string", "description": "Email of admin who performed action" },
        "action": { "type": "string", "description": "Action name (suspend, ban, dismiss, etc.)" },
        "targetId": { "type": "string", "description": "Target user or report UID" },
        "targetType": { "type": "string", "description": "Type of target: user, report, system" },
        "note": { "type": "string", "description": "Mandatory rationale written by admin" },
        "timestamp": { "type": "number", "description": "Unix timestamp in ms" }
      }
    },
    "LegalExportLog": {
      "path": "legal_exports/{exportId}",
      "fields": {
        "exportId": { "type": "string", "description": "Export identifier" },
        "adminUid": { "type": "string", "description": "UID of admin who initiated export" },
        "adminEmail": { "type": "string", "description": "Email of admin who initiated export" },
        "targetUserId": { "type": "string", "description": "Target user UID exported" },
        "orderReference": { "type": "string", "description": "Official legal order reference number" },
        "requestingAuthority": { "type": "string", "description": "Requesting court or law enforcement authority" },
        "orderDate": { "type": "string", "description": "Date of legal order" },
        "dataScope": { "type": "string", "description": "Scope of data included in export" },
        "timestamp": { "type": "number", "description": "Unix timestamp in ms" }
      }
    },
    "Report": {
      "path": "reports/{reportId}",
      "fields": {
        "id": { "type": "string", "description": "Report identifier" },
        "reporterId": { "type": "string", "description": "UID of user who filed report" },
        "reportedUserId": { "type": "string", "description": "UID of reported user" },
        "reportedUserName": { "type": "string", "description": "Public username of reported user" },
        "reason": { "type": "string", "enum": ["spam", "harassment", "fake_bot", "nudity", "underage", "other"], "description": "Reporting reason" },
        "priority": { "type": "string", "enum": ["critical", "high", "normal"], "description": "Report priority (critical for underage)" },
        "details": { "type": "string", "description": "User description of issue" },
        "attachedMessages": { "type": "array", "description": "Up to 20 messages attached by reporter" },
        "status": { "type": "string", "enum": ["pending", "dismissed", "warned", "suspended", "banned"], "description": "Resolution status" },
        "moderatorNote": { "type": "string", "description": "Mandatory note entered by admin" },
        "timestamp": { "type": "number", "description": "Timestamp created" }
      }
    },
    "AdminRole": {
      "path": "admin_roles/{uid}",
      "fields": {
        "uid": { "type": "string", "description": "Admin user UID" },
        "email": { "type": "string", "description": "Admin email address" },
        "role": { "type": "string", "description": "Role string (super_admin or admin)" },
        "grantedAt": { "type": "timestamp", "description": "Timestamp when admin role was granted" }
      }
    },
    "UserStatus": {
      "path": "user_status/{userId}",
      "fields": {
        "userId": { "type": "string", "description": "User UID" },
        "isDisabled": { "type": "boolean", "description": "Whether user access is disabled" },
        "status": { "type": "string", "enum": ["active", "suspended", "banned", "scheduled_for_deletion"], "description": "Account moderation status" },
        "disabledReason": { "type": "string", "description": "Reason for moderation action" },
        "updatedAt": { "type": "timestamp", "description": "Last status modification timestamp" },
        "updatedBy": { "type": "string", "description": "Admin UID who updated status" }
      }
    },
    "Conversation": {
      "path": "conversations/{id}",
      "fields": {
        "participants": { "type": "array", "items": { "type": "string" }, "description": "Array of 2 participant UIDs [uidA, uidB]" },
        "lastMessage": { "type": "string", "description": "Last message preview" },
        "lastMessageAt": { "type": "number", "description": "Timestamp of last message" },
        "mutedBy": { "type": "array", "items": { "type": "string" }, "description": "List of UIDs who muted" },
        "blockedBy": { "type": "array", "items": { "type": "string" }, "description": "List of UIDs who blocked" }
      }
    },
    "HfDailyUsage": {
      "path": "hf_daily_usage/{usageId}",
      "fields": {
        "uid": { "type": "string", "description": "User UID" },
        "date": { "type": "string", "description": "UTC calendar date YYYY-MM-DD" },
        "image": { "type": "number", "description": "Daily image generation count" },
        "music": { "type": "number", "description": "Daily music generation count" },
        "video": { "type": "number", "description": "Daily video generation count" },
        "updatedAt": { "type": "number", "description": "Last updated timestamp in ms" }
      }
    }
  }
}
