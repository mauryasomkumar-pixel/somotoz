rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if caller is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: Check if caller holds verified administrative authorization
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email == "mauryasomkumar@gmail.com" ||
        exists(/databases/$(database)/documents/admin_roles/$(request.auth.uid))
      );
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User application data (entries, activities, profile)
    // - Owner has full read and write access
    // - Authorized Admin has management access
    match /users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Activity and AI Query Audit Logs
    // - Authenticated users can ONLY create log records strictly bound to their own verified UID and verified email
    // - Normal users cannot read, list, update, or delete activity audit records
    // - Only authorized administrators can read, list, and manage audit logs
    match /admin_activity_logs/{logId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        (request.resource.data.userEmail == request.auth.token.email || request.auth.token.email == null);
      allow read, update, delete: if isAdmin();
    }

    // Admin Roles collection
    // - Normal users can only read their own role document to verify admin state
    // - Only verified admins can read all roles or modify roles
    match /admin_roles/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // User account status (enable/disable flags)
    // - Normal users can only read their own status
    // - Only verified admins can read all or write/update status
    match /user_status/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    // Safety & User Conduct Reports (18+ & moderation)
    // - Authenticated users can create reports strictly bound to their own reporterId
    // - Only verified admins can read, list, update, and manage reports
    match /somo_reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // Username Registry for live availability checking
    // - Any authenticated user can read to check availability
    // - Can only be created by the owning user
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Public Profiles (Only username, photo, bio, mood - never real name, email, or phone)
    // - Readable by all authenticated users for human directory in SomoChat
    // - Writable only by the owner or admin
    match /public_profiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }
  }
}

