# ========================================================
# SOMOTOZ ENVIRONMENT VARIABLES (.env.example - NO SECRETS)
# ========================================================

# Required: Google Gemini API Key (server-side only)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# Optional: Primary Gemini model alias (defaults to gemini-3.1-flash-lite)
GEMINI_MODEL="gemini-3.1-flash-lite"

# Optional: Hugging Face Inference Token (server-side only, NEVER prefix with VITE_)
HF_TOKEN=""
HF_IMAGE_MODEL="black-forest-labs/FLUX.1-schnell"
HF_MUSIC_MODEL="facebook/musicgen-small"
HF_VIDEO_MODEL=""

# Per-user daily generation limits for Hugging Face media routes
DAILY_IMAGE_LIMIT="5"
DAILY_MUSIC_LIMIT="3"
DAILY_VIDEO_LIMIT="1"

# Required: Public application URL (e.g. https://somotoz.vercel.app)
APP_URL="https://somotoz.vercel.app"

# Allowed CORS origins (comma-separated, e.g. https://somotoz.vercel.app)
CORS_ORIGIN="https://somotoz.vercel.app"

# Firebase Admin SDK Configuration (server-side only)
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
# Alternative Option: Full Service Account JSON stringified
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'

# Firebase Web Client Configuration (safe for client bundle, starts with VITE_)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""

# Optional: Scheduled retention cleanup configuration (defaults to 90 days)
RETENTION_DAYS="90"
# CRON_SECRET="your-random-cron-secret"

# Optional: WebRTC TURN server for reliable audio/video calls across strict NATs
VITE_TURN_SERVER_URL=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""
