# ========================================================
# SOMOTOZ ENVIRONMENT VARIABLES (.env.example - NO SECRETS)
# ========================================================

# Required: Google Gemini API Key (server-side only)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Required: Public application URL (e.g. https://somotoz.vercel.app)
APP_URL="https://somotoz.vercel.app"

# Allowed CORS origins (comma-separated, e.g. https://somotoz.vercel.app)
CORS_ORIGIN="https://somotoz.vercel.app"

# Firebase Admin SDK Configuration (server-side only; choose Option A or Option B)
FIREBASE_PROJECT_ID="your-firebase-project-id"
# Option A: Full Service Account JSON stringified
# FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}'
# Option B: Discrete Firebase Admin Credentials
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional: Scheduled retention cleanup configuration (defaults to 90 days)
RETENTION_DAYS="90"
# CRON_SECRET="your-random-cron-secret"

# Optional: WebRTC TURN server for reliable audio/video calls across strict NATs
VITE_TURN_SERVER_URL=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""
